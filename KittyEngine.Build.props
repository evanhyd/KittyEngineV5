<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EnableSyzygy Condition="'$(EnableSyzygy)' == ''">false</EnableSyzygy>
    <KittyBuildVariant Condition="'$(EnableSyzygy)' == 'true'">syzygy</KittyBuildVariant>
    <KittyBuildVariant Condition="'$(EnableSyzygy)' != 'true'">plain</KittyBuildVariant>
    <IntDir>$(ProjectDir)$(Platform)\$(Configuration)\$(KittyBuildVariant)\</IntDir>
    <OutDir Condition="'$(EnableSyzygy)' != 'true'">$(MSBuildThisFileDirectory)$(Platform)\$(Configuration)\</OutDir>
    <OutDir Condition="'$(EnableSyzygy)' == 'true'">$(MSBuildThisFileDirectory)$(Platform)\$(Configuration)\syzygy\</OutDir>
    <EngineObjectDirectory>$(MSBuildThisFileDirectory)KittyEngineV5\$(Platform)\$(Configuration)\$(KittyBuildVariant)\</EngineObjectDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)KittyEngineV5\config\$(KittyBuildVariant);$(MSBuildThisFileDirectory)KittyEngineV5;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="ValidateSyzygySetting" BeforeTargets="PrepareForBuild"
          Condition="'$(EnableSyzygy)' != 'true' and '$(EnableSyzygy)' != 'false'">
    <Error Text="EnableSyzygy must be true or false." />
  </Target>
</Project>
